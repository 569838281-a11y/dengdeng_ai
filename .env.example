# API配置
ZHIPU_API_KEY=your_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn

# 模型配置
LLM_PROVIDER=zhipu
OPENAI_MODEL=glm-4-flash

# 数据目录
DATA_DIR=data
PERSIST_DIRECTORY=chroma_db

# LLM 供应商（主备降级）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# 会话与任务队列
REDIS_URL=redis://localhost:16379/0
SESSION_TTL=3600

# 文档处理
USE_MINERU=False

# 分块策略
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_BY_SECTION=False

# 重排序配置（提升Precision@5）
USE_RERANKER=False
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_K=5
RERANKER_THRESHOLD=0.0

# 混合检索权重
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5

# 联网搜寻。只有检索信息里打开「联网搜寻」才使用。不要把真实密钥提交到仓库。
# WEB_SEARCH_ENGINE 可用 tavily（默认）、bing、bravesearch。
# WEB_SEARCH_ENDPOINT 留空则用该引擎的官方地址。
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENGINE=tavily
WEB_SEARCH_ENDPOINT=

# 灯灯最后一跳成文。true 时优先用本地 Qwen2.5-1.5B LoRA，校验失败再回退云端 teacher。
USE_LORA_REPLIER=false
